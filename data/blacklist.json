    "blacklist",
    "whitelist",
    "role",
    "ownerstats",
    "listcmds"
  ]
};

const COMMANDS = {};

function add(name, description, category, ownerOnly, run) {
  COMMANDS[name] = { name, description, category, ownerOnly, run };
}

function isOwner(sender, ownerNumber) {
  if (!sender || !ownerNumber) return false;
  return sender.includes(String(ownerNumber)) || sender.includes(ownerNumber.replace(/^0+/, ""));
}

function userKey(sender) {
  return String(sender || "unknown").replace(/@.*/, "");
}

add("menu", "Affiche le menu principal du bot.", "General", false, async ({ sock, jid, msg }) => {
  const lines = [];
  Object.entries(categories).forEach(([category, names]) => {
    lines.push(`⭐ ${category}:`);
    lines.push(names.map(n => `  • ${n}`).join("\n"));
    lines.push("");
  });
  await sock.sendMessage(jid, { text: `🤖 CHOCO ITACHI ALIEN\n\n${lines.join("\n")}` }, { quoted: msg });
});

add("help", "Affiche l’aide du bot avec recherche par mot-clé.", "General", false, async ({ sock, jid, msg, args }) => {
  const q = (args.join(" ") || "").toLowerCase();
  const entries = Object.entries(COMMANDS).filter(([name, data]) => {
    if (!q) return true;
    return name.toLowerCase().includes(q) || data.description.toLowerCase().includes(q) || data.category.toLowerCase().includes(q);
  });

  const text = entries.slice(0, 30).map(([name, data]) => `• ${name} — ${data.description}`).join("\n");

  await sock.sendMessage(jid, { text: `📘 Aide\n${text || "Aucune commande trouvée."}` }, { quoted: msg });
});

