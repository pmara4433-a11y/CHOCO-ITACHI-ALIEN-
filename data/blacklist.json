const fs = require("fs");
const path = require("path");

const ROOT = path.join(__dirname, "..");
const DATA_DIR = path.join(ROOT, "data");

if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });

const STORAGE_FILES = {
  blacklist: path.join(DATA_DIR, "blacklist.json"),
  roles: path.join(DATA_DIR, "roles.json")
};

function ensureJsonFile(filePath, defaultValue) {
  if (!fs.existsSync(filePath)) {
    fs.writeFileSync(filePath, JSON.stringify(defaultValue, null, 2), "utf8");
  }
}

ensureJsonFile(STORAGE_FILES.blacklist, []);
ensureJsonFile(STORAGE_FILES.roles, {});

const STORAGE = {
  blacklist: JSON.parse(fs.readFileSync(STORAGE_FILES.blacklist, "utf8") || "[]"),
  roles: JSON.parse(fs.readFileSync(STORAGE_FILES.roles, "utf8") || "{}")
};

function saveStorage(type) {
  const target = STORAGE_FILES[type];
  const value = JSON.stringify(STORAGE[type], null, 2);
  fs.writeFileSync(target, value, "utf8");
}

function ensureRole(target) {
  if (!STORAGE.roles[target]) STORAGE.roles[target] = { role: "user" };
  saveStorage("roles");
}

