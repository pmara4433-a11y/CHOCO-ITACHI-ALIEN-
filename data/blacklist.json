add("blacklist", "Ajoute un numéro à la blacklist (owner only).", "Owner", true, async ({ sock, jid, msg, args }) => {
  const target = args[0];
  if (!target) {
    await sock.sendMessage(jid, { text: "Exemple: .blacklist 224000000000" }, { quoted: msg });
    return;
  }
  if (!STORAGE.blacklist.includes(target)) {
    STORAGE.blacklist.push(target);
    saveStorage("blacklist");
  }
  await sock.sendMessage(jid, { text: `🚫 ${target} ajouté à la blacklist.` }, { quoted: msg });
});

add("whitelist", "Supprime un numéro de la blacklist (owner only).", "Owner", true, async ({ sock, jid, msg, args }) => {
  const target = args[0];
  if (!target) {
    await sock.sendMessage(jid, { text: "Exemple: .whitelist 224000000000" }, { quoted: msg });
    return;
  }
  const index = STORAGE.blacklist.indexOf(target);
  if (index >= 0) STORAGE.blacklist.splice(index, 1);
  saveStorage("blacklist");
  await sock.sendMessage(jid, { text: `✅ ${target} retiré de la blacklist.` }, { quoted: msg });
});

add("role", "Change le rôle d’un utilisateur (owner only).", "Owner", true, async ({ sock, jid, msg, args }) => {
  const target = args[0];
  const role = args[1] || "user";
  if (!target) {
    await sock.sendMessage(jid, { text: "Exemple: .role 224000000000 admin" }, { quoted: msg });
    return;
  }
  ensureRole(target);
  STORAGE.roles[target] = { role };
  saveStorage("roles");
  await sock.sendMessage(jid, { text: `🛡️ Rôle de ${target} défini sur ${role}.` }, { quoted: msg });
});

add("ownerstats", "Affiche les stats de l’owner pour le bot.", "Owner", true, async ({ sock, jid, msg }) => {
  await sock.sendMessage(jid, { text: `👑 Owner stats\nCommandes: ${Object.keys(COMMANDS).length}\nBlacklist: ${STORAGE.blacklist.length}\nRoles: ${Object.keys(STORAGE.roles).length}` }, { quoted: msg });
});

add("listcmds", "Liste un premier lot de commandes du bot.", "Owner", true, async ({ sock, jid, msg }) => {
  const names = Object.keys(COMMANDS).slice(0, 60).join(", ");
  await sock.sendMessage(jid, { text: `📚 ${names}` }, { quoted: msg });
});

for (let i = 1; i <= 360; i++) {
  const name = `cmd${String(i).padStart(3, "0")}`;
  COMMANDS[name] = {
    name,
    description: `Commande générée numéro ${i}.`,
    category: "General",
    ownerOnly: false,
    run: async ({ sock, jid, msg, args }) => {
      const suffix = args.length ? `\nArgs: ${args.join(" ")}` : "";
      await sock.sendMessage(jid, { text: `⚙️ ${name} activée.${suffix}` }, { quoted: msg });
    }
  };
}

module.exports = COMMANDS;

module.exports.__meta = {
  categories,
  STORAGE,
  isOwner,
  userKey
};
